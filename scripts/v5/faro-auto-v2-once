#!/usr/bin/env bash
# FARO Auto V2 and Noche A/B share one guarded queue. Disabled unless explicitly authorized.
set -euo pipefail
MODE="${1:-}"
case "$MODE" in auto|night-a|night-b) ;; *) echo "Usage: $0 auto|night-a|night-b" >&2; exit 20;; esac
[[ "${FARO_V5_EXECUTION_AUTHORIZED:-}" == YES ]] || { echo 'STOP: execution not authorized'; exit 20; }
[[ "${FARO_V5_AUTOMATION_AUTHORIZED:-}" == YES ]] || { echo 'STOP: automation not authorized'; exit 20; }
[[ "${FARO_V5_WRITER_COORDINATION_READY:-}" == YES ]] || { echo 'STOP: writer not certified'; exit 20; }
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
exec python3 "$ROOT/scripts/v5/faro-auto-v2-queue.py" once --mode "$MODE" --owner "${FARO_V5_WORKER_OWNER:?required}"
