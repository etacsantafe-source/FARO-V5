#!/usr/bin/env bash
# FARO Auto V2 — safe preflight. Never acquires writer nor starts workers.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT" ]] || { echo 'STOP: not a git repository'; exit 20; }
cd "$ROOT"
remote="$(git remote get-url origin 2>/dev/null || true)"
case "$remote" in
  git@github.com:etacsantafe-source/FARO-V5.git|https://github.com/etacsantafe-source/FARO-V5|https://github.com/etacsantafe-source/FARO-V5.git) ;;
  *) echo "STOP: wrong origin: $remote"; exit 20;;
esac
branch="$(git branch --show-current)"
case "$branch" in
  work/faro-auto-v2-integration-*|work/s3-*) ;;
  *) echo "STOP: non-isolated branch: $branch"; exit 20;;
esac
[[ -z "$(git status --porcelain)" ]] || { echo 'STOP: dirty worktree'; exit 20; }
[[ -f docs/s2-night/RUN_STATE.json ]] || { echo 'STOP: S2 state missing'; exit 20; }
[[ -f docs/v5/FARO_CONTINUITY_POINTER.json ]] || { echo 'STOP: continuity pointer missing'; exit 20; }
python3 - <<'PY'
import json
import os
import sys
s = json.load(open('docs/s2-night/RUN_STATE.json'))
p = json.load(open('docs/v5/FARO_CONTINUITY_POINTER.json'))
if s.get('phase') != 'S2_CLOSED' or s.get('certified') != s.get('total') or s.get('total') != 8:
    sys.exit('STOP: S2 is not CLOSED 8/8')
if s.get('v2_active_enabled') is not False or s.get('s4_open') is not False:
    sys.exit('STOP: S2 app V2/S4 invariant')
if p.get('app_v2_enabled') is not False or p.get('s4_open') is not False:
    sys.exit('STOP: pointer app V2/S4 invariant')
active = os.environ.get('FARO_V5_AUTOMATION_AUTHORIZED') == 'YES'
if active and not (p.get('s3_open') is True and p.get('automation', {}).get('activation_authorized') is True):
    sys.exit('STOP: S3/Noche require explicit durable activation')
print('PREFLIGHT PASS: S2 8/8, app V2 OFF, S4 OFF; activation-authorized:', active)
PY
echo "READ_ONLY_PASS: origin=$remote branch=$branch head=$(git rev-parse HEAD)"
echo 'PREFLIGHT_ONLY: still requires remote writer CAS, Resource Guard and explicit task authorization'
