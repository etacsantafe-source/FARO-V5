            android:name="ar.com.faro.v5.app.FaroV5F1IsolatedChatActivity"
            android:exported="true"
            android:label="FARO S2 CHAT AISLADO"
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- TEST-ONLY synthetic SAF picker. Separate isolated app ID; never in release. -->
        <activity
            android:name="ar.com.faro.v5.app.FaroV5T4SafIntegralActivity"
            android:exported="true"
            android:label="FARO T4 SAF INTEGRAL"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Isolated debug-only A5 fixture. Same UID as the app; never exported. -->
        <provider
            android:name="ar.com.faro.v5.app.FaroV5A5TestContentProvider"
            android:authorities="${applicationId}.a5test"
            android:exported="false" />
    </application>
</manifest>
