<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No external network or remote AI calls in V2 DEV. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <!-- M4 RED_FIX: suppress manifest-merged permissions in offline local DEV only. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="ar.com.faro.alpha.v2coredev.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <application
        android:name="ar.com.faro.v5.app.FaroV5V2CoreDevApplication"
        tools:replace="android:name">

        <!-- None of the shipping or legacy certification launchers may start in this UID. -->
        <activity android:name="ar.com.faro.v5.app.FaroV5BootstrapActivity" tools:node="remove" />
        <activity android:name="ar.com.faro.v5.app.FaroV5AiSettingsActivity" tools:node="remove" />
        <activity android:name="ar.com.faro.v5.app.FaroV5FiveStoreSafConsentActivity" tools:node="remove" />
        <activity android:name="ar.com.faro.v5.app.FaroV5P5PhysicalActivity" tools:node="remove" />
        <activity android:name="ar.com.faro.v5.app.FaroV5F1QuarantineCertificationActivity" tools:node="remove" />
        <activity android:name="ar.com.faro.v5.app.FaroV5F1IsolatedChatActivity" tools:node="remove" />
        <activity android:name="ar.com.faro.v5.app.FaroV5T4SafIntegralActivity" tools:node="remove" />
        <!-- The debug platform module's certification Activity is never part of local DEV. -->
        <activity android:name="ar.com.faro.v5.platform.android.cert.FaroV5P6CertificationActivity" tools:node="remove" />
        <!-- No background execution, certification providers or OS dispatch in this UID. -->
        <provider tools:node="removeAll" />
        <!-- W01 DEV-only private URI anchor. This is NOT a Finance data provider. -->
        <provider
            android:name="ar.com.faro.v5.app.S4W01FinanceReadPrivateInvalidationProvider"
            android:authorities="${applicationId}.finance9read"
            android:exported="false"
            android:grantUriPermissions="false"
            tools:node="merge" />
        <receiver tools:node="removeAll" />
        <service tools:node="removeAll" />
        <!-- D1A only: explicit private Messenger service for real two-PID Android CI.
             No Finance data, SQL access, grants, background dispatch or external IPC. -->
        <service
            android:name="ar.com.faro.v5.app.S4W01FinanceReadNoticeProbeService"
            android:exported="false"
            android:process=":w01ReadProbe" />
        <activity-alias tools:node="removeAll" />

        <!-- D1B0 isolated, non-exported FragmentActivity for future trusted Finance READ. -->
        <activity
            android:name="ar.com.faro.v5.app.FaroV5W01FinanceReadDevActivity"
            android:exported="false"
            android:label="Finanzas DEV · lectura protegida" />

        <activity
            android:name="ar.com.faro.v5.app.FaroV5W01FinanceDevLauncherActivity"
            android:exported="true"
            android:label="FARO W01 FINANZAS DEV"
            android:excludeFromRecents="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
